# Secrets and local runtime env
.env
*.env
*.env.*
!*.env.example
runtime.env
/secrets/
*.key
*.pem

# Runtime databases, logs and journals
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.journal
*.log

# Python / Node generated files
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.venv-test/
.mypy_cache/
.ruff_cache/
dist/
build/

# Local model/runtime data
ollama/
openwebui_data/
qdrant-snapshots/
kb-sync-state/

# Open WebUI runtime data inside stack
stack/.env
stack/.tmp_openapi.json
stack/openwebui_data/
stack/retention-reports/*
!stack/retention-reports/.gitkeep

# n8n runtime state
n8n/.n8n/
n8n/binaryData/
n8n/database.sqlite*
n8n/backups/
n8n/config
n8n/crash.journal
n8n/n8nEventLog*.log

# Internal knowledge/source documents are not pushed by default.
# Add sanitized markdown/docs explicitly when they are intended for GitHub.
knowledgebases/
*.pdf
*.docx
*.pptx
*.xlsx
*.xlsm
*.csv
*.mp3
*.webm

# Local brand/output templates and image libraries.
# Keep only README/JSON/placeholders in Git unless assets are explicitly cleared.
assets/templates/**/*.pdf
assets/templates/**/*.docx
assets/templates/**/*.pptx
assets/brand/logos/*
assets/presentation-images/**/*
!assets/**/.gitkeep
!assets/**/*.md
!assets/**/*.json

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.worktrees/
worktrees/

# Local rollout, backup, release and comparison artifacts
/.rollout/
/.tmp/
/.tmp-*/
/.admin-dashboard-git-metadata/
/backups/
/release/
/kb-portal-data/
eval/rag/results/rag-runtime-eval-*.jsonl
/*-AKTUALISIERT.py
/OWUI-File-Proxy-KURZE-DOWNLOADLINKS.py
*.tsbuildinfo

# Local manual backup copies
* - Kopie.*
* - Copy.*

# Die OpenWebUI-Tools werden aus mehreren Quelldateien zusammengebaut und
# von Hand in OpenWebUI eingefuegt. Nur die gebaute Fassung ist lauffaehig,
# deshalb gehoert sie ins Repository trotz der generischen dist/-Regel.
!stack/open-webui-tools/dist/
!stack/open-webui-tools/dist/*.py
