# Copying this file to .env is intentionally not required.
# Use scripts/secrets/set-kv-secret.ps1 and scripts/start-stack.ps1 instead.

KAHLE_ROOT=C:/kahle-vinci

# Pinned runtime images currently referenced by docker-compose.yml.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.10.2
N8N_IMAGE=n8nio/n8n:2.16.1
QDRANT_IMAGE=qdrant/qdrant:v1.17.1
SEARXNG_IMAGE=searxng/searxng:2026.4.13-ee66b070a

# IONOS OpenAI-compatible endpoint and model IDs.
IONOS_OPENAI_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_CHAT_MODEL_DEFAULT=mistralai/Mistral-Small-24B-Instruct
IONOS_CHAT_MODEL_REASONING=openai/gpt-oss-120b
IONOS_EMBEDDING_MODEL=BAAI/bge-m3

# Public localhost URL used in generated file download links.
PUBLIC_BASE_URL=http://localhost:8091

# Optional n8n websearch hook.
N8N_SAFE_WEBSEARCH_WEBHOOK_URL=http://n8n:5678/webhook/safe-websearch/h576htdr-5b9t-89r8-61wx-8a50bh988m6a
N8N_SAFE_WEBSEARCH_API_KEY=
N8N_SAFE_WEBSEARCH_TIMEOUT=50

# Knowledge-Base-Papierkorb (automatische Bereinigung täglich um 10:30 via n8n).
KB_ADMIN_TRASH_RETENTION_DAYS=30

# Required secrets are stored outside the repo in Windows Credential Manager:
# IONOS_API_KEY
# WEBUI_SECRET_KEY
# N8N_BASIC_AUTH_PASSWORD
# N8N_ENCRYPTION_KEY
# SEARXNG_SECRET_KEY
# FILE_LINK_SECRET
# OWUI_FILE_PROXY_API_KEY
# DOC_WORKER_API_KEY
# KAHLE/VECTOR second admin gate. Generate interactively with:
#   sudo python3 /opt/kahle-vinci/stack/scripts/configure-kb-admin-unlock.py
KB_ADMIN_UNLOCK_CODE_HASH=<generated-pbkdf2-hash>
KB_ADMIN_UNLOCK_SESSION_SECRET=<generated-random-secret>
KB_ADMIN_UNLOCK_TTL_SECONDS=28800
KB_ADMIN_UNLOCK_MAX_ATTEMPTS=5
KB_ADMIN_UNLOCK_BLOCK_SECONDS=900

# Vinci Wissensportal: frische Microsoft-Bestätigung für kritische Adminaktionen
KB_PORTAL_STEP_UP_SECRET=<generated-random-secret-min-43-chars>
KB_PORTAL_ENTRA_REDIRECT_URI=https://vinci.example.com/wissen/api/portal/auth/step-up/callback

# Microsoft Graph application permissions for portal notifications (Mail.Send)
KB_MAIL_TENANT_ID=<microsoft-tenant-uuid>
KB_MAIL_CLIENT_ID=<graph-mail-app-uuid>
KB_MAIL_CLIENT_SECRET=<graph-mail-app-secret>
KB_MAIL_SENDER=vinci@kahle.de
KB_MAIL_CAPTURE_PATH=/portal-data/mail-capture.jsonl

# 32 zufaellige Bytes, URL-safe Base64; Backup-Dienst nur mit Profil operations starten
KB_BACKUP_ENCRYPTION_KEY=
KAHLE_BACKUP_SECONDARY_ROOT=C:/kahle-vinci-backups
ENABLE_PORTAL_BACKUP_WORKER=False

# Only identities from the KAHLE Microsoft tenant domains may enter the portal.
PORTAL_ALLOWED_EMAIL_DOMAINS=kahle.de
