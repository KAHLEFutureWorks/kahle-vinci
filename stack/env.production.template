# Copy to /opt/kahle-vinci/stack/.env.production on the server.
# Never commit the real file. Generate secrets with:
#   openssl rand -base64 48

KAHLE_ROOT=/opt/kahle-vinci

PUBLIC_HOSTNAME=vinci.example.com
WEBUI_URL=https://vinci.example.com
ACME_EMAIL=admin@example.com

IONOS_OPENAI_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_CHAT_MODEL_DEFAULT=mistralai/Mistral-Small-24B-Instruct
IONOS_CHAT_MODEL_REASONING=openai/gpt-oss-120b
IONOS_EMBEDDING_MODEL=BAAI/bge-m3

OAUTH_ALLOWED_DOMAINS=kahle.de
OPENID_PROVIDER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
MICROSOFT_CLIENT_ID=<client-id>
MICROSOFT_CLIENT_SECRET=<client-secret>
MICROSOFT_CLIENT_TENANT_ID=<tenant-id>
MICROSOFT_REDIRECT_URI=https://vinci.example.com/oauth/microsoft/callback
MICROSOFT_OAUTH_SCOPE=openid email profile offline_access
DEFAULT_USER_ROLE=pending

# Secure defaults: Microsoft SSO only. Enable both values temporarily only for
# an explicitly controlled break-glass window, then disable them again.
ENABLE_LOGIN_FORM=False
ENABLE_PASSWORD_AUTH=False

IONOS_API_KEY=<secret>
WEBUI_SECRET_KEY=<secret>
N8N_BASIC_AUTH_PASSWORD=<secret>
N8N_ENCRYPTION_KEY=<secret>
SEARXNG_SECRET_KEY=<secret>
FILE_LINK_SECRET=<secret>
OWUI_FILE_PROXY_API_KEY=<secret>
DOC_WORKER_API_KEY=<secret>
OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=<secret>
OAUTH_CLIENT_INFO_ENCRYPTION_KEY=<secret>
